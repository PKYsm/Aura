# ── Discord ──────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here
PREFIX=$

# ── Lavalink (music engine) ────────────────────────────────
LAVALINK_NAME=AuraNode
LAVALINK_HOST=localhost:2333
LAVALINK_URL=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_AUTH=youshallnotpass
LAVALINK_SECURE=false

# ── Spotify (search/resolve) ────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Lyrics ───────────────────────────────────────────────────
# /lyrics tries LRCLIB (synced, no key) -> lyrics.ovh (plain, no key) -> Genius (plain, needs a key) in that order.
# GENIUS_TOKEN is only used as a last-resort fallback; the command works without it.
GENIUS_TOKEN=your_genius_api_token

# ── Logging webhooks (optional) ─────────────────────────────
WEBHOOK_COMMAND=
WEBHOOK_ERROR=
WEBHOOK_GUILD=
WEBHOOK_NP=
WEBHOOK_PREMIUM=
