# ── Discord ──────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_application_client_id

# ── Lavalink Node ────────────────────────
LAVALINK_URL=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Default search engine prefix (anything but YouTube):
# spsearch (Spotify) | dzsearch (Deezer) | jssearch (JioSaavn)
# amsearch (Apple Music) | gnsearch (Gaana) | ytmsearch (YT Music)
DEFAULT_SEARCH_ENGINE=spsearch

# ── Database (Upstash Redis - L2) ────────
UPSTASH_REDIS_URL=rediss://default:password@your-upstash-endpoint:6379

# ── Logging ───────────────────────────────
LOG_LEVEL=info
